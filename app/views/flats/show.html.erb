<div class="flat-banner overflow-hidden">
  <%= image_tag flat_picture_url(@flat), alt: @flat.name, class: "w-100 h-100 object-fit-cover" %>
</div>

<div class="container flat-show-container pb-5">
  <div class="row g-4">
    <div class="col-lg-8">
      <div class="flat-info-card p-4 mb-4">
        <h1 class="fw-bold mb-2"><%= @flat.name %></h1>
        <p class="text-muted mb-0">
          <i class="fa-solid fa-location-dot me-2 text-danger"></i><%= @flat.address %>
        </p>
      </div>

      <div class="flat-info-card p-4 mb-4">
        <h2 class="h4 fw-bold mb-3">A bit more about this flat...</h2>
        <p class="mb-0 lh-base"><%= @flat.description %></p>
      </div>

      <div class="flat-info-card p-4">
        <h2 class="h4 fw-bold mb-3">Details</h2>
        <div class="d-flex flex-wrap gap-4 fs-5">
          <span>
            <i class="fa-solid fa-user-group me-2 text-secondary"></i>
            <%= pluralize(@flat.number_of_guests, "guest") %>
          </span>
          <span>
            <i class="fa-solid fa-euro-sign me-2 text-secondary"></i>
            <%= @flat.price_per_night %> / night
          </span>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="flat-info-card p-4 mb-4">
        <h2 class="h5 fw-bold mb-3">Book this place!</h2>
        <form onsubmit="return false;">
          <div class="input-group mb-3">
            <span class="input-group-text">From:</span>
            <input type="date" class="form-control" aria-label="Check-in date">
          </div>
          <div class="input-group mb-3">
            <span class="input-group-text">To:</span>
            <input type="date" class="form-control" aria-label="Check-out date">
          </div>
          <button type="submit" class="btn btn-success w-100 fw-semibold">Book</button>
        </form>
      </div>

      <div class="flat-info-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="fw-bold">Share</span>
          <div class="d-flex gap-3 fs-5 text-secondary">
            <i class="fa-brands fa-square-facebook"></i>
            <i class="fa-brands fa-square-twitter"></i>
            <i class="fa-brands fa-square-pinterest"></i>
            <i class="fa-solid fa-envelope"></i>
          </div>
        </div>

        <hr>

        <div class="d-grid gap-2">
          <%= link_to "Edit flat", edit_flat_path(@flat), class: "btn btn-outline-warning" %>
          <%= link_to "Remove flat",
                      flat_path(@flat),
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to remove this flat?" },
                      class: "btn btn-outline-danger" %>
          <%= link_to "Back to all flats", flats_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </div>
  </div>
</div>

