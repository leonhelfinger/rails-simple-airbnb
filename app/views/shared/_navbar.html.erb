<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-3">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand fw-bold d-flex align-items-center gap-2 text-dark" do %>
      <i class="fa-solid fa-house-chimney text-danger"></i>
      <span>Simple Airbnb</span>
    <% end %>

    <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
      <%= form_with url: flats_path, method: :get, local: true, class: "d-flex gap-2" do |f| %>
        <%= f.search_field :query,
                           value: params[:query],
                           placeholder: "Search by name or address",
                           aria: { label: "Search flats" },
                           class: "form-control" %>
        <%= f.submit "Search", name: nil, class: "btn btn-outline-success" %>
      <% end %>

      <%= link_to "Add Flat", new_flat_path, class: "btn btn-outline-primary" %>
    </div>
  </div>
</nav>

